{
  "expo": {
    "name": "Field App Complete",
    "slug": "field-app-complete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuvi.installhub",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Field App Complete needs camera access to scan device barcodes and capture switchboard and device photos.",
        "NSPhotoLibraryUsageDescription": "Field App Complete needs photo library access to attach site photos.",
        "NSLocationWhenInUseUsageDescription": "Field App Complete uses your location to record installation coordinates on field forms."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.tuvi.installhub",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Field App Complete needs camera access to scan device barcodes and capture installation photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Field App Complete to attach site and device photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Field App Complete to record installation coordinates on field forms."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF8"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#26997A",
          "defaultChannel": "scheduler"
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "0bbcc4dc-40f4-475f-9292-1ebfb70af9c9"
      }
    },
    "owner": "rajchodisetti1"
  }
}
